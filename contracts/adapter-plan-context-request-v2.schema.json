{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keeptoy.github.io/pwf-codex-cloud-hooks/contracts/adapter-plan-context-request-v2.schema.json",
  "title": "planning-with-files adapter to owned plan-context request v2",
  "$comment": "Exact-v2 managed canonical plan-context request. F2A produces allowed_profiles=[legacy, smart]; autonomous remains reserved for a separately reviewed activation gate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime", "event", "project", "policy", "output_budget"],
  "properties": {
    "schema_version": { "const": 2 },
    "runtime": { "const": "codex" },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "session_id", "turn_id"],
      "properties": {
        "name": { "enum": ["SessionStart", "UserPromptSubmit"] },
        "source": {
          "type": ["string", "null"],
          "enum": ["startup", "resume", "clear", "compact", null]
        },
        "session_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "minLength": 1,
              "maxLength": 128
            },
            { "type": "null" }
          ]
        },
        "turn_id": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 128 },
            { "type": "null" }
          ]
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "plan_id"],
      "properties": {
        "root": { "$ref": "#/$defs/absolutePath" },
        "plan_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
              "minLength": 1,
              "maxLength": 128
            },
            { "type": "null" }
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planning_enabled", "allowed_profiles", "opt_in_protocol"],
      "properties": {
        "planning_enabled": { "type": "boolean" },
        "allowed_profiles": {
          "type": "array",
          "prefixItems": [
            { "const": "legacy" },
            { "const": "smart" },
            { "const": "autonomous" }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "opt_in_protocol": { "const": "codex-managed-v1" }
      }
    },
    "output_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_context_chars", "max_plan_lines", "max_progress_lines"],
      "properties": {
        "max_context_chars": { "const": 20000 },
        "max_plan_lines": { "const": 50 },
        "max_progress_lines": { "const": 20 }
      }
    }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "pattern": "^/",
      "minLength": 2,
      "maxLength": 4096
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "properties": { "name": { "const": "SessionStart" } },
            "required": ["name"]
          }
        }
      },
      "then": {
        "properties": {
          "event": {
            "properties": {
              "source": { "enum": ["startup", "resume", "clear", "compact"] },
              "turn_id": { "type": "null" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "event": {
            "properties": { "source": { "type": "null" } }
          }
        }
      }
    }
  ]
}
